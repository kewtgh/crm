# Local Compose-oriented example. Production uses the separate least-privilege
# files under deploy/*.env.example; do not combine those files on the server.
APP_URL=https://crm.example.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-production-site-key
TURNSTILE_SECRET_KEY=replace-with-an-independent-32-byte-secret
TURNSTILE_EXPECTED_HOSTNAME=crm.example.com
ALTCHA_HMAC_SECRET=replace-with-an-independent-32-byte-secret
DATABASE_URL=postgresql://crm_app:replace-with-app-password@postgres:5432/lumina_crm
SYSTEM_DATABASE_URL=postgresql://crm_system:replace-with-system-password@postgres:5432/lumina_crm
WORKER_DATABASE_URL=postgresql://crm_worker:replace-with-worker-password@postgres:5432/lumina_crm
MIGRATION_DATABASE_URL=postgresql://crm_migrator:replace-with-migrator-password@postgres:5432/lumina_crm
BACKUP_DATABASE_URL=postgresql://crm_backup:replace-with-backup-password@postgres:5432/lumina_crm
DATABASE_ADMIN_URL=postgresql://postgres:replace-with-superuser-password@postgres:5432/lumina_crm
DATABASE_SSL=false
DATABASE_POOL_MAX=12
SYSTEM_DATABASE_POOL_MAX=4
WORKER_DATABASE_POOL_MAX=4
CRM_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
LOGIN_THROTTLE_HASH_SECRET=replace-with-an-independent-32-byte-secret
TRUSTED_DEVICE_HASH_SECRET=replace-with-an-independent-32-byte-secret
TOTP_ENCRYPTION_KEY=replace-with-32-byte-hex-or-base64-key
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_ROOT=/var/lib/lumina-crm/objects
OBJECT_STORAGE_SIGNING_SECRET=replace-with-an-independent-32-byte-secret
EMAIL_DELIVERY_WEBHOOK_URL=https://mailer.example.invalid/crm-delivery
EMAIL_DELIVERY_WEBHOOK_TOKEN=replace-with-an-independent-32-byte-token
WORKER_JOB_CONCURRENCY=4
OUTBOX_BATCH_SIZE=20
CALENDAR_DELIVERY_BATCH_SIZE=20
EXPORT_BATCH_SIZE=10
EXPORT_MAX_ROWS=250000
REMINDER_BATCH_SIZE=100
WEBHOOKS_ENABLED=false
INTEGRATION_SYNC_ENABLED=false
OBSERVABILITY_ENABLED=false
SSO_ENABLED=false
SCIM_ENABLED=false
