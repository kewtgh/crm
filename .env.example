APP_URL=https://crm.example.com
# Turnstile remains the default provider. ALTCHA is the same-origin fallback;
# its independent HMAC secret signs challenges and one-time attestations.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-production-site-key
TURNSTILE_SECRET_KEY=replace-with-production-secret-key
TURNSTILE_EXPECTED_HOSTNAME=crm.example.com
ALTCHA_HMAC_SECRET=replace-with-an-independent-32-byte-random-secret

# PostgreSQL listens only on the VPS loopback interface. Runtime identities are
# deliberately separate from the migration and cluster-administration roles.
DATABASE_URL=postgresql://crm_app:replace-with-app-password@127.0.0.1:5432/lumina_crm
SYSTEM_DATABASE_URL=postgresql://crm_system:replace-with-system-password@127.0.0.1:5432/lumina_crm
WORKER_DATABASE_URL=postgresql://crm_worker:replace-with-worker-password@127.0.0.1:5432/lumina_crm
MIGRATION_DATABASE_URL=postgresql://crm_migrator:replace-with-migrator-password@127.0.0.1:5432/lumina_crm
DATABASE_ADMIN_URL=postgresql://postgres:replace-with-admin-password@127.0.0.1:5432/lumina_crm
DATABASE_SSL=false
DATABASE_POOL_MAX=12
SYSTEM_DATABASE_POOL_MAX=4
WORKER_DATABASE_POOL_MAX=4
CRM_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
# Independent HMAC key for account/source login-throttle identifiers.
LOGIN_THROTTLE_HASH_SECRET=replace-with-at-least-32-random-bytes
# Independent HMAC key for signed email-verification state and trusted-device
# tokens. Rotating this key invalidates every remembered device.
TRUSTED_DEVICE_HASH_SECRET=replace-with-a-different-32-byte-random-secret
# 32-byte key encoded as 64 hexadecimal characters or standard base64.
TOTP_ENCRYPTION_KEY=replace-with-a-32-byte-encryption-key

# Object storage. "local" requires a persistent absolute path outside releases;
# "s3" requires every S3_* value below. Database rows store object keys only.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_ROOT=/var/lib/lumina-crm/objects
OBJECT_STORAGE_SIGNING_SECRET=replace-with-an-independent-32-byte-random-secret
S3_ENDPOINT=https://objects.example.com
S3_REGION=auto
S3_BUCKET=lumina-crm
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key
S3_FORCE_PATH_STYLE=true

# Enterprise OIDC. Only listed domains can start SSO; users must already be
# provisioned as CRM staff (or staged through SCIM).
SSO_ENABLED=false
SSO_ALLOWED_DOMAINS=example.com
SSO_AUTHORIZATION_URL=https://identity.example.com/oauth2/authorize
SSO_TOKEN_URL=https://identity.example.com/oauth2/token
SSO_USERINFO_URL=https://identity.example.com/oauth2/userinfo
SSO_CLIENT_ID=replace-with-oidc-client-id
SSO_CLIENT_SECRET=replace-with-oidc-client-secret
# SCIM stages directory users and deprovisions bound identities. It never grants
# SUPER_ADMIN or ADMIN. Rotate this independent bearer token regularly.
SCIM_ENABLED=false
SCIM_BEARER_TOKEN=replace-with-an-independent-scim-bearer-token

# Server-side email delivery endpoint. It handles notification outbox messages,
# staff-account-created, calendar-invite, calendar-update, and calendar-cancel
# templates. It must never log temporaryPassword values.
EMAIL_DELIVERY_WEBHOOK_URL=https://mailer.example.com/crm-delivery
EMAIL_DELIVERY_WEBHOOK_TOKEN=replace-with-a-server-only-token
OUTBOX_BATCH_SIZE=20
CALENDAR_DELIVERY_BATCH_SIZE=20
EXPORT_BATCH_SIZE=10
# Hard ceiling for an export job. Jobs fail explicitly instead of silently
# truncating rows, and record expected/exported counts plus a SHA-256 receipt.
EXPORT_MAX_ROWS=250000
REMINDER_BATCH_SIZE=100

# Provider webhook signatures. Each configured provider must use a different
# long, randomly generated server-only secret.
# Webhook and integration workers are optional. They are ignored by the worker
# cycle and readiness checks until their explicit feature flag is true.
WEBHOOKS_ENABLED=false
WEBHOOK_MICROSOFT_365_SECRET=replace-with-a-long-random-secret
WEBHOOK_GOOGLE_CALENDAR_SECRET=replace-with-a-long-random-secret
WEBHOOK_EMAIL_SECRET=replace-with-a-long-random-secret
WEBHOOK_E_SIGNATURE_SECRET=replace-with-a-long-random-secret
WEBHOOK_ACCOUNTING_SECRET=replace-with-a-long-random-secret
WEBHOOK_PAYMENT_SECRET=replace-with-a-long-random-secret
WEBHOOK_PROCESSOR_URL=https://integration-worker.example.com/crm-events
WEBHOOK_PROCESSOR_TOKEN=replace-with-a-server-only-token
WEBHOOK_BATCH_SIZE=20

# Provider-specific sync adapter. It receives a provider, direction and opaque
# cursor, and returns { "nextCursor": "..." } only after the provider confirms
# the sync. OAuth/callback services confirm connections through the
# system-role-only confirm_integration_connection transaction function.
INTEGRATION_SYNC_ENABLED=false
INTEGRATION_SYNC_PROCESSOR_URL=https://integration-worker.example.com/crm-sync
INTEGRATION_SYNC_PROCESSOR_TOKEN=replace-with-a-server-only-token
INTEGRATION_SYNC_BATCH_SIZE=10
# Optional stable instance identifier; when omitted each process generates one.
WORKER_ID=

# Provider-neutral, allow-listed API telemetry. Payloads contain only route,
# method, status, duration, outcome, and request ID; no CRM or identity data.
OBSERVABILITY_ENABLED=false
OBSERVABILITY_WEBHOOK_URL=https://telemetry.example.com/lumina/events
OBSERVABILITY_WEBHOOK_TOKEN=replace-with-a-server-only-observability-token
OBSERVABILITY_SAMPLE_RATE=1

# Optional future external AI adapter. The current product remains rules-first
# and never sends CRM data externally. Setting these only marks a provider as
# configured; a reviewed adapter must still be explicitly implemented and enabled.
AI_PROVIDER_ENABLED=false
AI_PROVIDER_URL=
AI_PROVIDER_TOKEN=

# One-shot administrator initialization credentials.
# Run `npm run auth:bootstrap-admin`, then remove ADMIN_PASSWORD immediately.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-temporary-password
ADMIN_CHINESE_NAME=系统管理员
ADMIN_ENGLISH_NAME=System Administrator
ADMIN_USERNAME=lumina.admin
ADMIN_ROTATE_PASSWORD=false
# Optional absolute path for a one-time, mode-0600 bootstrap credential receipt.
ADMIN_CREDENTIAL_OUTPUT_PATH=
