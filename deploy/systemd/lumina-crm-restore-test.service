[Unit]
Description=Lumina CRM encrypted PostgreSQL restore verification
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=lumina-crm
Group=lumina-crm
WorkingDirectory=/opt/lumina-crm/current
EnvironmentFile=/etc/lumina-crm/deploy.env
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY FTP_PROXY RSYNC_PROXY http_proxy https_proxy all_proxy no_proxy ftp_proxy rsync_proxy LUMINA_HTTPS_PROXY NODE_OPTIONS NODE_USE_ENV_PROXY GIT_PROXY_COMMAND NPM_CONFIG_PROXY NPM_CONFIG_HTTPS_PROXY NPM_CONFIG_NOPROXY GLOBAL_AGENT_HTTP_PROXY GLOBAL_AGENT_HTTPS_PROXY GLOBAL_AGENT_NO_PROXY
ExecStart=/usr/bin/node scripts/db-restore-test.mjs
TimeoutStartSec=2h
TimeoutStopSec=30s
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/lumina-crm/backups

[Install]
WantedBy=multi-user.target
