[Unit]
Description=Lumina CRM image-based Compose deployment runner
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lumina-crm
Group=lumina-crm
WorkingDirectory=/opt/lumina-crm/source
EnvironmentFile=/etc/lumina-crm/deploy.env
Environment=DOCKER_CONFIG=/var/lib/lumina-crm/docker-config
Environment=BUILDX_CONFIG=/var/lib/lumina-crm/docker-config/buildx
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY FTP_PROXY RSYNC_PROXY http_proxy https_proxy all_proxy no_proxy ftp_proxy rsync_proxy LUMINA_HTTPS_PROXY NODE_OPTIONS NODE_USE_ENV_PROXY GIT_PROXY_COMMAND NPM_CONFIG_PROXY NPM_CONFIG_HTTPS_PROXY NPM_CONFIG_NOPROXY GLOBAL_AGENT_HTTP_PROXY GLOBAL_AGENT_HTTPS_PROXY GLOBAL_AGENT_NO_PROXY
ExecStart=/usr/bin/flock --nonblock --exclusive --conflict-exit-code=73 /var/lib/lumina-crm/deploy.lock /usr/bin/node /opt/lumina-crm/source/scripts/deploy-production-runner.mjs
TimeoutStartSec=infinity
TimeoutStopSec=30s
KillMode=mixed
Restart=no
UMask=0027
StateDirectory=lumina-crm
StateDirectoryMode=0750
LogsDirectory=lumina-crm
LogsDirectoryMode=0750
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/opt/lumina-crm/source /var/lib/lumina-crm /var/log/lumina-crm
