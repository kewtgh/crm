[Unit]
Description=Lumina CRM encrypted Compose backup task
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lumina-crm
Group=lumina-crm
WorkingDirectory=/opt/lumina-crm/source
EnvironmentFile=/etc/lumina-crm/deploy.env
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy NODE_OPTIONS
ExecStart=/usr/bin/docker compose --project-name lumina-crm --profile ops --env-file /var/lib/lumina-crm/deployments/compose.env -f /opt/lumina-crm/source/compose.production.yml run --rm backup
TimeoutStartSec=1h
TimeoutStopSec=30s
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/lumina-crm

[Install]
WantedBy=multi-user.target
