# Backup-only boundary. crm_backup has read-only database privileges.
BACKUP_DATABASE_URL=postgresql://crm_backup:replace-with-backup-password@postgres:5432/lumina_crm
BACKUP_LOCAL_ROOT=/var/lib/lumina-crm/backups
BACKUP_ENCRYPTION_KEY=replace-with-32-byte-key-as-64-hex-or-base64
# Remote retention is enforced by the independent object-provider lifecycle.
BACKUP_RETENTION_DAYS=30
# Encrypted staging copies remain in the local backup volume for restore tests.
BACKUP_LOCAL_RETENTION_HOURS=48
BACKUP_LOCAL_OBJECTS=true
BACKUP_OBJECTS_ROOT=/var/lib/lumina-crm/objects
BACKUP_S3_ENDPOINT=https://backup-objects.example.invalid
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=lumina-crm-database-backups
BACKUP_S3_ACCESS_KEY_ID=replace-with-backup-access-key
BACKUP_S3_SECRET_ACCESS_KEY=replace-with-backup-secret-key
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_NOTIFICATION_WEBHOOK_URL=https://alerts.example.invalid/lumina-backups
BACKUP_NOTIFICATION_WEBHOOK_TOKEN=replace-with-backup-alert-token
