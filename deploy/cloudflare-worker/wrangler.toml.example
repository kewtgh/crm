name = "lumina-crm-public-gateway"
main = "src/index.mjs"
compatibility_date = "2026-07-30"
workers_dev = false

# Bind crm.ewaya.com in the reviewed Cloudflare account during provisioning.
# routes = [{ pattern = "crm.ewaya.com/*", zone_name = "ewaya.com" }]

[vars]
PUBLIC_HOSTNAME = "crm.ewaya.com"
ORIGIN_URL = "https://replace-with-distinct-lumina-origin.invalid"

# Set only with:
#   npx wrangler secret put ORIGIN_AUTH_SECRET
# Never add ORIGIN_AUTH_SECRET to this file.
