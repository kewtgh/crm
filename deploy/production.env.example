# Web-only runtime secret file. Install as:
# /etc/lumina-crm/secrets/production.env (root:lumina-crm, 0644).
# The Web container must not receive Worker, migrator, backup, restore, or
# PostgreSQL administrator credentials.
APP_URL=https://crm.example.invalid
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-production-site-key
TURNSTILE_SECRET_KEY=replace-with-an-independent-32-byte-secret
TURNSTILE_EXPECTED_HOSTNAME=crm.example.invalid
ALTCHA_HMAC_SECRET=replace-with-an-independent-32-byte-secret

DATABASE_URL=postgresql://crm_app:replace-with-app-password@postgres:5432/lumina_crm
SYSTEM_DATABASE_URL=postgresql://crm_system:replace-with-system-password@postgres:5432/lumina_crm
DATABASE_SSL=false
DATABASE_POOL_MAX=12
SYSTEM_DATABASE_POOL_MAX=4
CRM_WORKSPACE_ID=00000000-0000-4000-8000-000000000001

LOGIN_THROTTLE_HASH_SECRET=replace-with-an-independent-32-byte-secret
TRUSTED_DEVICE_HASH_SECRET=replace-with-an-independent-32-byte-secret
TOTP_ENCRYPTION_KEY=replace-with-32-byte-hex-or-base64-key
OBJECT_STORAGE_SIGNING_SECRET=replace-with-an-independent-32-byte-secret
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_ROOT=/var/lib/lumina-crm/objects

# Only non-secret topology flags are shared with Web readiness. Provider tokens
# remain in worker.env.
WEBHOOKS_ENABLED=false
INTEGRATION_SYNC_ENABLED=false
SSO_ENABLED=false
SCIM_ENABLED=false
OBSERVABILITY_ENABLED=false
AI_PROVIDER_ENABLED=false
