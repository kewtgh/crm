# Runtime-only production configuration. Install as
# /etc/lumina-crm/production.env with root:lumina-crm ownership and mode 0640.
# Replace every placeholder before deployment. Deployment, backup, database
# administration, and one-time administrator credentials do not belong here.

APP_URL=https://crm.ewaya.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-production-site-key
TURNSTILE_SECRET_KEY=replace-with-an-independent-32-byte-secret
TURNSTILE_EXPECTED_HOSTNAME=crm.ewaya.com
ALTCHA_HMAC_SECRET=replace-with-a-different-32-byte-secret

# The v3 self-hosted architecture requires three independent runtime roles.
DATABASE_URL=postgresql://crm_app:replace-with-app-password@127.0.0.1:5432/lumina_crm
SYSTEM_DATABASE_URL=postgresql://crm_system:replace-with-system-password@127.0.0.1:5432/lumina_crm
WORKER_DATABASE_URL=postgresql://crm_worker:replace-with-worker-password@127.0.0.1:5432/lumina_crm
DATABASE_SSL=false
DATABASE_POOL_MAX=12
SYSTEM_DATABASE_POOL_MAX=4
WORKER_DATABASE_POOL_MAX=4

CRM_WORKSPACE_ID=replace-with-workspace-uuid
LOGIN_THROTTLE_HASH_SECRET=replace-with-an-independent-32-byte-secret
TRUSTED_DEVICE_HASH_SECRET=replace-with-a-different-32-byte-secret
TOTP_ENCRYPTION_KEY=replace-with-a-32-byte-hex-or-base64-key

# The reviewed systemd units permit local writes only under this persistent root.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_ROOT=/var/lib/lumina-crm/objects
OBJECT_STORAGE_SIGNING_SECRET=replace-with-an-independent-32-byte-secret

# To use S3, set OBJECT_STORAGE_PROVIDER=s3 and configure every value below.
# S3_ENDPOINT=https://objects.your-provider.invalid
# S3_REGION=auto
# S3_BUCKET=lumina-crm
# S3_ACCESS_KEY_ID=replace-with-s3-access-key
# S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key
# S3_FORCE_PATH_STYLE=true

# The provider must honor Idempotency-Key for identical notification/calendar replays.
EMAIL_DELIVERY_WEBHOOK_URL=https://replace-with-mailer.invalid/crm-delivery
EMAIL_DELIVERY_WEBHOOK_TOKEN=replace-with-an-independent-32-byte-token
WORKER_JOB_CONCURRENCY=4
OUTBOX_BATCH_SIZE=20
CALENDAR_DELIVERY_BATCH_SIZE=20
EXPORT_BATCH_SIZE=10
EXPORT_MAX_ROWS=250000
REMINDER_BATCH_SIZE=100

# Optional integrations are off until their complete provider-specific settings
# have been reviewed and added to this protected file.
SSO_ENABLED=false
SCIM_ENABLED=false
WEBHOOKS_ENABLED=false
INTEGRATION_SYNC_ENABLED=false
OBSERVABILITY_ENABLED=false
AI_PROVIDER_ENABLED=false
