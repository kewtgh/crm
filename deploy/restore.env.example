# Restore-test administrator boundary. This is never mounted into backup,
# Web, Worker, or migration containers.
RESTORE_DATABASE_ADMIN_URL=postgresql://postgres:replace-with-superuser-password@postgres:5432/lumina_crm
BACKUP_LOCAL_ROOT=/var/lib/lumina-crm/backups
BACKUP_ENCRYPTION_KEY=replace-with-32-byte-key-as-64-hex-or-base64
# Fail closed unless the database dump has a same-timestamp encrypted object archive.
RESTORE_REQUIRE_LOCAL_OBJECTS=true
