# Deployment-only database credentials. Install as
# /etc/lumina-crm/deploy.env with root:lumina-crm ownership and mode 0640.
# Never copy this file into a release and never place these values in sudoers.
DATABASE_ADMIN_URL=postgresql://postgres:replace-with-admin-password@127.0.0.1:5432/lumina_crm
MIGRATION_DATABASE_URL=postgresql://crm_migrator:replace-with-migrator-password@127.0.0.1:5432/lumina_crm
CRM_APP_DB_PASSWORD=replace-with-independent-app-password
CRM_SYSTEM_DB_PASSWORD=replace-with-independent-system-password
CRM_WORKER_DB_PASSWORD=replace-with-independent-worker-password
CRM_MIGRATOR_DB_PASSWORD=replace-with-independent-migrator-password
CRM_BACKUP_DB_PASSWORD=replace-with-independent-backup-password

# Encrypted off-site backup target.
BACKUP_DATABASE_URL=postgresql://crm_backup:replace-with-backup-password@127.0.0.1:5432/lumina_crm
BACKUP_LOCAL_ROOT=/var/lib/lumina-crm/backups
BACKUP_ENCRYPTION_KEY=replace-with-32-byte-key-as-64-hex-or-base64
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ENDPOINT=https://objects-backup.example.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=lumina-crm-backups
BACKUP_S3_ACCESS_KEY_ID=replace-with-backup-access-key
BACKUP_S3_SECRET_ACCESS_KEY=replace-with-backup-secret-key
BACKUP_NOTIFICATION_WEBHOOK_URL=https://alerts.example.com/lumina-backups
BACKUP_NOTIFICATION_WEBHOOK_TOKEN=replace-with-backup-alert-token

# Host-capacity alerting. The notification keys may be omitted to reuse backup notifications.
DISK_MONITOR_PATHS=/,/opt/lumina-crm/releases,/var/lib/postgresql,/var/lib/lumina-crm
DISK_FREE_PERCENT_THRESHOLD=15
DISK_NOTIFICATION_WEBHOOK_URL=https://alerts.example.com/lumina-disk
DISK_NOTIFICATION_WEBHOOK_TOKEN=replace-with-disk-alert-token

# Mandatory pre-deployment storage gate and project-only cleanup policy.
# LUMINA_DOCKER_DATA_ROOT must exactly match `docker info --format '{{.DockerRootDir}}'`.
LUMINA_DOCKER_DATA_ROOT=/var/lib/docker
LUMINA_DEPLOY_MIN_FREE_PERCENT=15
LUMINA_ROOT_MIN_FREE_GB=8
LUMINA_DOCKER_MIN_FREE_GB=10
LUMINA_RELEASE_MIN_FREE_GB=8
LUMINA_RELEASE_RETENTION=5
LUMINA_FAILED_RELEASE_RETENTION_HOURS=24
LUMINA_BUILDKIT_CACHE_RETENTION_HOURS=168
LUMINA_BUILDKIT_MAX_CACHE_GB=12
LUMINA_BUILDKIT_RESERVED_CACHE_GB=2
