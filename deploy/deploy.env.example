# Host deployment-controller settings. This file contains no database or
# application secrets. Install as /etc/lumina-crm/deploy.env.
LUMINA_COMPOSE_PROJECT=lumina-crm
LUMINA_COMPOSE_FILE=/opt/lumina-crm/source/compose.production.yml
LUMINA_SECRETS_DIR=/etc/lumina-crm/secrets
LUMINA_IMAGE_REPOSITORY=lumina-crm
LUMINA_OPS_IMAGE_REPOSITORY=lumina-crm-ops
LUMINA_PUBLIC_HOSTNAME=crm.ewaya.com
LUMINA_PUBLIC_HEALTH_URL=https://crm.ewaya.com/api/health
LUMINA_ORIGIN_HEALTH_URL=https://replace-with-distinct-origin.example.com/api/health
LUMINA_ORIGIN_ENV_FILE=/etc/lumina-crm/origin.env
LUMINA_POSTGRES_VOLUME=lumina-crm-postgres-data
LUMINA_OBJECTS_VOLUME=lumina-crm-objects
LUMINA_BACKUPS_VOLUME=lumina-crm-backups
LUMINA_BACKEND_NETWORK=lumina-crm-backend
LUMINA_EDGE_NETWORK=lumina-crm-edge
LUMINA_DOCKER_DATA_ROOT=/var/lib/docker
LUMINA_DEPLOY_MIN_FREE_PERCENT=15
LUMINA_ROOT_MIN_FREE_GB=8
LUMINA_DOCKER_MIN_FREE_GB=10
LUMINA_STATE_MIN_FREE_GB=4
LUMINA_IMAGE_RETENTION=5
LUMINA_BUILDKIT_CACHE_RETENTION_HOURS=168
LUMINA_BUILDKIT_MAX_CACHE_GB=12
LUMINA_BUILDKIT_RESERVED_CACHE_GB=2

# Optional and used only as an environment override for one failed git fetch.
# It is never written to Git config and is never inherited by Docker containers.
LUMINA_GIT_FALLBACK_PROXY=
