# Non-secret Compose interpolation and accepted image references.
LUMINA_COMPOSE_PROJECT=lumina-crm
LUMINA_IMAGE=lumina-crm:replace-with-full-40-character-commit
LUMINA_OPS_IMAGE=lumina-crm-ops:replace-with-full-40-character-commit
LUMINA_PUBLIC_HOSTNAME=crm.example.com
LUMINA_WEB_BIND=127.0.0.1:3200
LUMINA_SECRETS_DIR=/etc/lumina-crm/secrets
LUMINA_POSTGRES_VOLUME=lumina-crm-postgres-data
LUMINA_OBJECTS_VOLUME=lumina-crm-objects
LUMINA_BACKUPS_VOLUME=lumina-crm-backups
LUMINA_BACKEND_NETWORK=lumina-crm-backend
LUMINA_EDGE_NETWORK=lumina-crm-edge
