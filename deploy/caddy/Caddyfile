{$LUMINA_ORIGIN_HOSTNAME} {
	encode zstd gzip

	route {
		@origin_authorized header X-Lumina-Origin-Auth {$LUMINA_ORIGIN_AUTH_SECRET}
		handle @origin_authorized {
			@detailed_readiness {
				path /api/health
				query mode=ready
			}
			respond @detailed_readiness 404

			reverse_proxy 127.0.0.1:3200 {
				header_up -X-Lumina-Origin-Auth
				header_up -X-Forwarded-For
				header_up -X-Forwarded-Host
				header_up -X-Forwarded-Proto
				header_up -X-Real-IP
				header_up -CF-Connecting-IP
				header_up X-Forwarded-For {http.request.header.X-Lumina-Client-IP}
				header_up CF-Connecting-IP {http.request.header.X-Lumina-Client-IP}
				header_up X-Forwarded-Host {$LUMINA_PUBLIC_HOSTNAME}
				header_up X-Forwarded-Proto https
				header_up Host {$LUMINA_PUBLIC_HOSTNAME}
				header_up -X-Lumina-Client-IP
			}
		}

		respond 403
	}

	header {
		Cache-Control "private, no-store, max-age=0"
		-Server
	}
}
