http://127.0.0.1:3211 {
	encode zstd gzip

	route {
		@public_host host {$LUMINA_PUBLIC_HOSTNAME}
		handle @public_host {
			@detailed_readiness {
				path /api/health
				query mode=ready
			}
			respond @detailed_readiness 404

			reverse_proxy 127.0.0.1:3200 {
				header_up -Forwarded
				header_up -X-Forwarded-*
				header_up -X-Real-IP
				header_up -True-Client-IP
				header_up -X-Lumina-*
				header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
				header_up X-Real-IP {http.request.header.CF-Connecting-IP}
				header_up CF-Connecting-IP {http.request.header.CF-Connecting-IP}
				header_up X-Forwarded-Host {$LUMINA_PUBLIC_HOSTNAME}
				header_up X-Forwarded-Proto https
				header_up Host {$LUMINA_PUBLIC_HOSTNAME}
			}
		}

		respond 404
	}

	header {
		Cache-Control "private, no-store, max-age=0"
		-Server
	}
}
