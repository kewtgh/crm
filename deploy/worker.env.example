# Worker-only runtime secret file.
WORKER_DATABASE_URL=postgresql://crm_worker:replace-with-worker-password@postgres:5432/lumina_crm
WORKER_DATABASE_POOL_MAX=4
CRM_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
WORKER_ID=
INVITATION_CREDENTIAL_ENCRYPTION_KEY=replace-with-the-same-32-byte-hex-or-base64-key-as-web

OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_ROOT=/var/lib/lumina-crm/objects
# S3_ENDPOINT=https://objects.example.invalid
# S3_REGION=auto
# S3_BUCKET=lumina-crm-runtime
# S3_ACCESS_KEY_ID=replace-with-runtime-access-key
# S3_SECRET_ACCESS_KEY=replace-with-runtime-secret-key
# S3_FORCE_PATH_STYLE=true

# Worker notification, reminder, calendar, and communication delivery uses this endpoint.
# These values must exactly match production.env authentication-email configuration; the token
# must match the Cloudflare Email Worker secret LUMINA_WEBHOOK_TOKEN.
# RESEND_API_KEY and LUMINA_WEBHOOK_TOKEN remain exclusively Cloudflare Email Worker secrets.
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_TOKEN=
WORKER_JOB_CONCURRENCY=4
OUTBOX_BATCH_SIZE=20
CALENDAR_DELIVERY_BATCH_SIZE=20
COMMUNICATION_DELIVERY_BATCH_SIZE=20
EXPORT_BATCH_SIZE=10
EXPORT_MAX_ROWS=250000
REMINDER_BATCH_SIZE=100

WEBHOOKS_ENABLED=false
INTEGRATION_SYNC_ENABLED=false
OBSERVABILITY_ENABLED=false
SSO_ENABLED=false
SCIM_ENABLED=false

# Optional until approved contract-document generation is enabled. Same protected key for web and worker.
# 32-byte base64 or 64 hex characters; keep outside Git; rotate only after re-encrypting existing configurations.
DOCUMENT_CONFIGURATION_ENCRYPTION_KEY=
