# Worker-only runtime secret file.
WORKER_DATABASE_URL=postgresql://crm_worker:replace-with-worker-password@postgres:5432/lumina_crm
WORKER_DATABASE_POOL_MAX=4
CRM_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
WORKER_ID=

OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_ROOT=/var/lib/lumina-crm/objects
# S3_ENDPOINT=https://objects.example.invalid
# S3_REGION=auto
# S3_BUCKET=lumina-crm-runtime
# S3_ACCESS_KEY_ID=replace-with-runtime-access-key
# S3_SECRET_ACCESS_KEY=replace-with-runtime-secret-key
# S3_FORCE_PATH_STYLE=true

EMAIL_DELIVERY_WEBHOOK_URL=https://mail-api.ewaya.com/lumina-crm/delivery
EMAIL_DELIVERY_WEBHOOK_TOKEN=replace-with-an-independent-32-byte-token
WORKER_JOB_CONCURRENCY=4
OUTBOX_BATCH_SIZE=20
CALENDAR_DELIVERY_BATCH_SIZE=20
EXPORT_BATCH_SIZE=10
EXPORT_MAX_ROWS=250000
REMINDER_BATCH_SIZE=100

WEBHOOKS_ENABLED=false
INTEGRATION_SYNC_ENABLED=false
OBSERVABILITY_ENABLED=false
SSO_ENABLED=false
SCIM_ENABLED=false
