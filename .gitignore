/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.devserver*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
.dev.vars
.dev.vars.*
wrangler.production.toml
wrangler.production.json
wrangler.production.jsonc

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/supabase/.branches/
/supabase/.temp/

# Private operational material; schema migrations and reviewed public templates stay tracked.
*.env
*.log
*.dump
*.backup
*.key
*.p12
*.pfx
/logs/
/backups/
/exports/
/private-documents/
/private-contracts/
__pycache__/

